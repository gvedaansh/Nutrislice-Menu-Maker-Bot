# Copy this file to .env and fill in your key, or just run "python Planner.py"
# and it will ask for your key and create .env for you.
# .env is ignored by git, so your key stays on your computer.

# Your API key from any supported provider.
LLM_API_KEY=

# Optional. Guessed from the key when left blank.
# One of: openai, gemini, anthropic, openrouter, groq, xai, mistral, deepseek, ollama
LLM_PROVIDER=

# Optional for gemini (defaults to gemini-3.8-flash); required for the others.
# Setup lists the models your key can use.
LLM_MODEL=

# Optional. Only for providers not in the list above that accept
# OpenAI-style requests, e.g. https://example.com/v1
LLM_BASE_URL=
